# Copiar a la raiz del proyecto en la VM como ".env" y completar. Este archivo NUNCA se sube a git con valores reales.
# Contrasenas: letras mayusculas y minusculas, numeros y un simbolo, 12 o mas caracteres (SQL Server lo exige). Evitar $ y # y comillas.

# --- Direccion publica ---
# Con HTTPS (certificado automatico): el nombre DNS de la VM. Para probar antes sin HTTPS: SITE_ADDRESS=:80
SITE_ADDRESS=savagegrill.brazilsouth.cloudapp.azure.com
ALLOWED_HOSTS=savagegrill.brazilsouth.cloudapp.azure.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://savagegrill.brazilsouth.cloudapp.azure.com
DEBUG=False
# Generar una propia: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CAMBIAR

# --- Base de datos (SQL Server en contenedor) ---
DB_NAME=RestauranteDB
DB_USER=sa
DB_PASSWORD=CAMBIAR

# --- RabbitMQ ---
RABBIT_USER=savage
RABBIT_PASS=CAMBIAR

# --- Mercado Pago ---
MP_MODO=simulado
# Para cobrar con Mercado Pago de verdad: MP_MODO=prueba (credenciales de PRUEBA, nadie paga de verdad) o produccion (plata real).
# El token se carga a mano en la VM (nano .env), nunca en el chat ni en git. Despues: docker compose -f docker-compose.prod.yml up -d api worker_mercadopago
# MP_ACCESS_TOKEN=APP_USR-...   (Access Token de la aplicacion, seccion Credenciales de Mercado Pago Developers)
MP_FRONT_URL=https://savagegrill.brazilsouth.cloudapp.azure.com
# Opcionales (valores por defecto): vida del link en minutos y cada cuantos segundos el worker confirma los pagos
# MP_EXPIRACION_MIN=30
# MP_SYNC_INTERVALO_SEG=15
# El sistema confirma los pagos consultando a Mercado Pago cada MP_SYNC_INTERVALO_SEG segundos (no hace falta webhook).
